<view name="productsWithPrice" modelName="delivery" defaultAuthorizationRole="ROLE_DELIVERIES"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schema.qcadoo.org/view"
      xsi:schemaLocation="http://schema.qcadoo.org/view http://schema.qcadoo.org/view.xsd">

    <component type="window" name="window" reference="window">

        <ribbon>
            <group name="navigation">
                <bigButton name="back" icon="backIcon24.png" state="enabled" action="#{window}.performBackWithoutConfirm" />
            </group>
            <group name="action">
                <bigButton name="enterPricesToDeliveredProducts" icon="generateIcon24.png" state="enabled">
                    <script>
                        <![CDATA[
                            this.addOnChangeListener({
                                onClick: function() {
                                    #{deliveredProducts}.enterPricesToDeliveredProducts();
                                }
                            });
                        ]]>
                    </script>
                </bigButton>
            </group>
        </ribbon>

        <windowTab name="mainTab">
            <component type="form" name="form" reference="form">
                <component type="gridLayout" name="gridLayout" columns="1"
                           rows="1">
                    <layoutElement column="1" row="1">
                        <component type="grid" name="deliveredProducts" reference="deliveredProducts"
                                   useDto="true" source="#{form}.deliveredProductDtos">
                            <script>
                                QCD = QCD || {};
                                QCD.translations = QCD.translations || {};

                                QCD.translations['deliveries.productsWithPrice.invalidScale.max'] =
                                '#{translate(deliveries.productsWithPrice.invalidScale.max)}';

                                QCD.translations['deliveries.productsWithPrice.invalidPrecision.max'] =
                                '#{translate(deliveries.productsWithPrice.invalidPrecision.max)}';
                            </script>
                            <script type="text/javascript" src="/deliveries/public/js/productsWithPrice.js"></script>

                            <option type="column" name="succession" fields="succession" width="10"/>

                            <option type="column" name="productNumber" fields="productNumber" width="80"/>
                            <option type="column" name="pricePerUnit" fields="pricePerUnit" width="80" formatter="input"/>
                            <option type="order" column="succession" direction="asc"/>

                            <option type="searchable" value=""/>
                            <option type="orderable" value=""/>

                            <option type="suppressSelectEvent" value="true"/>

                            <option type="paginable" value="false"/>
                            <option type="prioritizable" value="false"/>

                            <listener event="enterPricesToDeliveredProducts"
                                      class="com.qcadoo.mes.deliveries.listeners.ProductsWithPriceListeners"
                                      method="enterPricesToDeliveredProducts"/>
                        </component>
                    </layoutElement>
                </component>

                <option type="header" value="true"/>
                <option type="expression" value=""/>
            </component>
        </windowTab>

    </component>

    <hooks>
        <beforeRender class="com.qcadoo.mes.deliveries.hooks.ProductsWithPriceHooks"
                      method="onBeforeRender"/>
    </hooks>

</view>
